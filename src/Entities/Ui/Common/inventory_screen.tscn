[gd_scene format=3 uid="uid://c0ic80o0pvev8"]

[sub_resource type="GDScript" id="GDScript_ijoh7"]
script/source = "class_name InventoryScreen
extends CanvasLayer

signal opened()
signal closed()

@export var root_path: NodePath = ^\"Root\"
@export var book_texture_path: NodePath = ^\"Root/BookCenter/BookRoot/BookTexture\"
@export var slot_grid_path: NodePath = ^\"Root/BookCenter/BookRoot/SlotArea/SlotGrid\"
@export var page_selector_path: NodePath = ^\"Root/BookCenter/BookRoot/PageSelector\"
@export var item_name_label_path: NodePath = ^\"Root/BookCenter/BookRoot/DetailsPanel/DetailsVBox/ItemNameLabel\"
@export var item_description_label_path: NodePath = ^\"Root/BookCenter/BookRoot/DetailsPanel/DetailsVBox/ItemDescriptionLabel\"
@export var item_props_label_path: NodePath = ^\"Root/BookCenter/BookRoot/DetailsPanel/DetailsVBox/ItemPropsLabel\"

@export var slot_widget_scene: PackedScene = preload(\"res://src/Entities/Ui/Inventory/inventory_slot_widget.tscn\")
@export_range(1, 60, 1) var slots_per_page: int = 20
@export_range(1, 10, 1) var slot_columns: int = 4
@export var page_selector_button_size: Vector2 = Vector2(32, 32)

@export_group(\"Book Art\")
@export var book_frame_1: Texture2D = preload(\"res://src/Entities/Ui/Assets/Gui-Hud/Inventory Book/InventoryBook_01.png\")
@export var book_frame_2: Texture2D = preload(\"res://src/Entities/Ui/Assets/Gui-Hud/Inventory Book/InventoryBook_02.png\")
@export var book_frame_3: Texture2D = preload(\"res://src/Entities/Ui/Assets/Gui-Hud/Inventory Book/InventoryBook_03.png\")
@export var book_frame_4: Texture2D = preload(\"res://src/Entities/Ui/Assets/Gui-Hud/Inventory Book/InventoryBook_04.png\")
@export var page_selector_off_texture: Texture2D = preload(\"res://src/Entities/Ui/Assets/Gui-Hud/Inventory Book/InventoryChapter_Off.png\")
@export var page_selector_on_texture: Texture2D = preload(\"res://src/Entities/Ui/Assets/Gui-Hud/Inventory Book/InventoryChapter_On.png\")

var _inventory_component: Node
var _book_frames: Array[Texture2D] = []
var _current_page: int = 0
var _selected_slot_index: int = -1
var _is_animating: bool = false

@onready var _root: Control = get_node_or_null(root_path) as Control
@onready var _book_texture: TextureRect = get_node_or_null(book_texture_path) as TextureRect
@onready var _slot_grid: GridContainer = get_node_or_null(slot_grid_path) as GridContainer
@onready var _page_selector: HBoxContainer = get_node_or_null(page_selector_path) as HBoxContainer
@onready var _item_name_label: Label = get_node_or_null(item_name_label_path) as Label
@onready var _item_description_label: RichTextLabel = get_node_or_null(item_description_label_path) as RichTextLabel
@onready var _item_props_label: RichTextLabel = get_node_or_null(item_props_label_path) as RichTextLabel


func _ready() -> void:
	_book_frames = [book_frame_1, book_frame_2, book_frame_3, book_frame_4]
	if _root:
		_root.visible = false
	if _book_texture and book_frame_1:
		_book_texture.texture = book_frame_1

	_rebuild_page_selector()
	_refresh_inventory_view()


func set_inventory_component(component: Node) -> void:
	if _inventory_component and _inventory_component.has_signal(\"inventory_changed\"):
		var previous_callable: Callable = Callable(self, \"_on_inventory_changed\")
		if _inventory_component.is_connected(\"inventory_changed\", previous_callable):
			_inventory_component.disconnect(\"inventory_changed\", previous_callable)

	_inventory_component = component
	if _inventory_component and _inventory_component.has_signal(\"inventory_changed\"):
		var changed_callable: Callable = Callable(self, \"_on_inventory_changed\")
		if not _inventory_component.is_connected(\"inventory_changed\", changed_callable):
			_inventory_component.connect(\"inventory_changed\", changed_callable)

	_current_page = 0
	_selected_slot_index = -1
	_refresh_inventory_view()


func toggle_inventory() -> void:
	if _is_animating:
		return

	if _root and _root.visible:
		close_inventory()
		return

	open_inventory()


func open_inventory() -> void:
	if _root == null:
		return
	if _root.visible:
		return

	_root.visible = true
	await _play_book_animation(true)
	_refresh_inventory_view()
	_emit_inventory_opened_event()
	opened.emit()


func close_inventory() -> void:
	if _root == null or not _root.visible:
		return

	await _play_book_animation(false)
	_root.visible = false
	closed.emit()


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"inventory\"):
		toggle_inventory()
		get_viewport().set_input_as_handled()


func _refresh_inventory_view() -> void:
	_populate_slots()
	_rebuild_page_selector()
	_update_details_panel()


func _populate_slots() -> void:
	if _slot_grid == null:
		return

	for child in _slot_grid.get_children():
		child.queue_free()

	_slot_grid.columns = maxi(1, slot_columns)

	var slots: Array = _get_slots()
	var start_index: int = _current_page * slots_per_page
	var end_index: int = start_index + slots_per_page

	for slot_index in range(start_index, end_index):
		var slot_widget: Node = slot_widget_scene.instantiate()
		if slot_widget == null:
			continue

		_slot_grid.add_child(slot_widget)

		var slot_data: Variant = null
		if slot_index >= 0 and slot_index < slots.size():
			slot_data = slots[slot_index]

		if slot_widget.has_method(\"configure\"):
			slot_widget.call_deferred(\"configure\", slot_index, slot_data)
		if slot_widget.has_signal(\"slot_pressed\"):
			var slot_pressed_callable: Callable = Callable(self, \"_on_slot_pressed\")
			if not slot_widget.is_connected(\"slot_pressed\", slot_pressed_callable):
				slot_widget.connect(\"slot_pressed\", slot_pressed_callable)

	if _selected_slot_index < start_index or _selected_slot_index >= end_index:
		_selected_slot_index = -1


func _rebuild_page_selector() -> void:
	if _page_selector == null:
		return

	for child in _page_selector.get_children():
		child.queue_free()

	var page_count: int = _get_total_pages()
	for page_index in range(page_count):
		var button := TextureButton.new()
		button.custom_minimum_size = page_selector_button_size
		button.focus_mode = Control.FOCUS_ALL
		button.stretch_mode = TextureButton.STRETCH_KEEP_CENTERED
		button.toggle_mode = true
		button.button_pressed = page_index == _current_page
		button.texture_normal = page_selector_off_texture
		button.texture_pressed = page_selector_on_texture
		button.texture_hover = page_selector_on_texture
		button.texture_disabled = page_selector_off_texture
		button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
		button.pressed.connect(_on_page_button_pressed.bind(page_index))
		_page_selector.add_child(button)

	_sync_page_selector_states()


func _sync_page_selector_states() -> void:
	if _page_selector == null:
		return

	for page_index in range(_page_selector.get_child_count()):
		var button: TextureButton = _page_selector.get_child(page_index) as TextureButton
		if button == null:
			continue
		button.button_pressed = page_index == _current_page
		button.texture_normal = page_selector_on_texture if button.button_pressed else page_selector_off_texture


func _on_page_button_pressed(page_index: int) -> void:
	var page_count: int = _get_total_pages()
	_current_page = clampi(page_index, 0, page_count - 1)
	_selected_slot_index = -1
	_refresh_inventory_view()


func _on_slot_pressed(slot_index: int) -> void:
	_selected_slot_index = slot_index
	_update_details_panel()


func _update_details_panel() -> void:
	if _item_name_label == null or _item_description_label == null or _item_props_label == null:
		return

	var slots: Array = _get_slots()
	if _selected_slot_index < 0 or _selected_slot_index >= slots.size():
		_item_name_label.text = \"Inventory\"
		_item_description_label.text = \"Select an item slot to inspect item properties.\"
		_item_props_label.text = \"\"
		return

	var slot_data: Variant = slots[_selected_slot_index]
	var slot_is_empty: bool = true
	var item: Resource = null
	var amount: int = 0
	if slot_data != null:
		if slot_data.has_method(\"is_empty\"):
			slot_is_empty = bool(slot_data.call(\"is_empty\"))
		item = slot_data.get(\"item\")
		amount = int(slot_data.get(\"amount\"))

	if slot_data == null or slot_is_empty or item == null:
		_item_name_label.text = \"Empty Slot\"
		_item_description_label.text = \"This slot does not contain an item.\"
		_item_props_label.text = \"\"
		return

	_item_name_label.text = \"%s x%d\" % [str(item.get(\"display_name\")), amount]
	_item_description_label.text = str(item.get(\"description\"))
	_item_props_label.text = _format_item_props(item.get(\"props\"))


func _format_item_props(props: Variant) -> String:
	if not (props is Dictionary):
		return \"No custom properties.\"

	var props_dict: Dictionary = props as Dictionary
	if props_dict.is_empty():
		return \"No custom properties.\"

	var lines: PackedStringArray = []
	for key in props_dict.keys():
		lines.append(\"- %s: %s\" % [str(key), str(props_dict[key])])
	lines.sort()
	return \"\\n\".join(lines)


func _get_slots() -> Array:
	if _inventory_component == null:
		return []
	if _inventory_component.has_method(\"get_slots\"):
		return _inventory_component.call(\"get_slots\")
	return []


func _get_total_pages() -> int:
	var total_slots: int = slots_per_page
	if _inventory_component and _inventory_component.has_method(\"get_slot_count\"):
		total_slots = int(_inventory_component.call(\"get_slot_count\"))
	return maxi(1, int(ceil(float(maxi(1, total_slots)) / float(maxi(1, slots_per_page)))))


func _play_book_animation(is_opening: bool) -> void:
	if _book_texture == null:
		return

	_is_animating = true
	var sequence: PackedInt32Array
	if is_opening:
		sequence = PackedInt32Array([0, 1, 2, 3, 0]) # 01 -> 02 -> 03 -> 04 -> 01
	else:
		sequence = PackedInt32Array([0, 3, 2, 1, 0]) # 01 -> 04 -> 03 -> 02 -> 01

	for frame_index in sequence:
		if frame_index >= 0 and frame_index < _book_frames.size():
			var frame_texture: Texture2D = _book_frames[frame_index]
			if frame_texture:
				_book_texture.texture = frame_texture
		await get_tree().create_timer(0.04).timeout
	_is_animating = false


func _emit_inventory_opened_event() -> void:
	var ui_events: Node = get_node_or_null(\"/root/UIEvents\")
	if ui_events and ui_events.has_signal(\"inventory_opened\"):
		ui_events.emit_signal(\"inventory_opened\")
		return

	var event_bus: Node = get_node_or_null(\"/root/EventBus\")
	if event_bus and event_bus.has_signal(\"inventory_opened\"):
		event_bus.emit_signal(\"inventory_opened\")


func _on_inventory_changed() -> void:
	_refresh_inventory_view()
"

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_details_panel"]
